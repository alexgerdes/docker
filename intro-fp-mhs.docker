# Build MicroHs and install it in a separate stage

FROM mcr.microsoft.com/devcontainers/base:alpine AS mhs
# User configuration
ENV USER_NAME=vscode
ENV HOME=/home/${USER_NAME}
WORKDIR ${HOME}
RUN apk add --no-cache openssh git gcc musl-dev make
RUN git clone --depth 1 https://github.com/augustss/MicroHs.git
WORKDIR ${HOME}/MicroHs
RUN make minstall

FROM mcr.microsoft.com/devcontainers/base:alpine

# Meta data
LABEL maintainer="alexg@chalmers.se"
LABEL version="0.1"
LABEL description="Development with GHC for the Intro FP course."

# Build arguments
ARG HLS=false

# User configuration
ENV USER_NAME=vscode
ENV HOME=/home/${USER_NAME}
WORKDIR ${HOME}

# Install tools
RUN apk update && \
    apk add --no-cache fzf ripgrep lazygit neovim tree-sitter-cli

# Copy MicroHs from the build stage
COPY --from=mhs ${HOME}/.mcabal ${HOME}/.mcabal

# Run next commands as user
RUN chown -R ${USER_NAME}:${USER_NAME} ${HOME}
USER ${USER_NAME} 

# Add cabal bin path
ENV PATH=$PATH:${HOME}/.local/bin:${HOME}/.mcabal/bin:$PATH

# Use nice command line theme
RUN git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
RUN ${HOME}/.oh-my-zsh/custom/themes/powerlevel10k/gitstatus/install

COPY zsh/.zshrc.introfp ${HOME}/.zshrc
COPY zsh/.p10k.zsh.introfp ${HOME}/.p10k.zsh

# Fix spurious issue with git ownership
RUN git config --global --add safe.directory '*'

# Install dependencies
RUN mcabal update 
RUN mcabal install containers && mcabal install transformers && \
    mcabal install mtl-mhs && mcabala install time && mcabal install splitmix && \
    mcabal install random-mhs && mcabal install QuickCheck
# RUN mcabal install --global --lib QuickCheck directory random ansi-terminal time hspec

# Start with ZSH
ENTRYPOINT ["/bin/zsh"]
