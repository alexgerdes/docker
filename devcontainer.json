{
  "name": "FP dev image",
  "image": "agerdes/fp-dev:ht26",
  "customizations": {
    "vscode": {
      "extensions": [
        "haskell.language-haskell"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        }
      }
    }
  }
}
